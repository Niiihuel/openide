+/*---------------------------------------------------------------------------------------------
+ *  OpenIDE — helper para hacer un POST y consumir la respuesta SSE de forma incremental,
+ *  vía IRequestService (que pasa por el proceso main → sin problemas de CORS).
+ *--------------------------------------------------------------------------------------------*/
+
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { VSBuffer, VSBufferReadableStream } from '../../../../base/common/buffer.js';
+import { listenStream } from '../../../../base/common/stream.js';
+import { IHeaders } from '../../../../base/parts/request/common/request.js';
+import { IRequestService } from '../../../../platform/request/common/request.js';
+
+export interface ISsePostOptions {
+	readonly url: string;
+	readonly headers: IHeaders;
+	readonly body: string;
+}
+
+function readAll(stream: VSBufferReadableStream): Promise<string> {
+	return new Promise<string>(resolve => {
+		let buf = '';
+		listenStream(stream, {
+			onData: (c: VSBuffer) => { buf += c.toString(); },
+			onError: () => resolve(buf),
+			onEnd: () => resolve(buf),
+		});
+	});
+}
+
+/**
+ * Hace el POST y va llamando `onBlock` por cada bloque SSE completo (texto entre
+ * líneas en blanco). El parseo específico de cada provider lo hace el caller.
+ */
+export async function ssePost(
+	requestService: IRequestService,
+	options: ISsePostOptions,
+	token: CancellationToken,
+	onBlock: (block: string) => void
+): Promise<void> {
+	const ctx = await requestService.request({
+		type: 'POST',
+		url: options.url,
+		headers: options.headers,
+		data: options.body,
+	}, token);
+
+	const status = ctx.res.statusCode ?? 0;
+	if (status < 200 || status >= 300) {
+		const errBody = await readAll(ctx.stream);
+		throw new Error(`HTTP ${status}: ${errBody.slice(0, 800)}`);
+	}
+
+	let buffer = '';
+	await new Promise<void>((resolve, reject) => {
+		listenStream(ctx.stream, {
+			onData: (chunk: VSBuffer) => {
+				buffer += chunk.toString();
+				let idx: number;
+				while ((idx = buffer.indexOf('\n\n')) !== -1) {
+					const block = buffer.slice(0, idx);
+					buffer = buffer.slice(idx + 2);
+					if (block.trim()) {
+						onBlock(block);
+					}
+				}
+			},
+			onError: err => reject(err),
+			onEnd: () => {
+				if (buffer.trim()) {
+					onBlock(buffer);
+				}
+				resolve();
+			},
+		}, token);
+	});
+}
+
+/** Extrae el valor `data:` de un bloque SSE (concatenando múltiples líneas data:). */
+export function sseDataOf(block: string): string | undefined {
+	const datas: string[] = [];
+	for (const line of block.split('\n')) {
+		if (line.startsWith('data:')) {
+			datas.push(line.slice(5).trimStart());
+		}
+	}
+	return datas.length ? datas.join('\n') : undefined;
+}
+
+/** Extrae el `event:` de un bloque SSE (usado por Anthropic). */
+export function sseEventOf(block: string): string | undefined {
+	for (const line of block.split('\n')) {
+		if (line.startsWith('event:')) {
+			return line.slice(6).trim();
+		}
+	}
+	return undefined;
+}
diff --git a/src/vs/workbench/contrib/openideAgent/common/providers/anthropicProvider.ts b/src/vs/workbench/contrib/openideAgent/common/providers/anthropicProvider.ts
