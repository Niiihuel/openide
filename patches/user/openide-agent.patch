@@ -0,0 +1,75 @@
+/*---------------------------------------------------------------------------------------------
+ *  OpenIDE — tipos base del motor de chat agéntico.
+ *--------------------------------------------------------------------------------------------*/
+
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+
+export type ChatRole = 'system' | 'user' | 'assistant' | 'tool';
+
+/** Credencial resuelta para autenticar contra el provider (API key u OAuth). */
+export type ICredential =
+	| { readonly kind: 'apiKey'; readonly value: string }
+	| { readonly kind: 'oauth'; readonly token: string };
+
+export interface IToolCall {
+	readonly id: string;
+	readonly name: string;
+	/** Argumentos como JSON string (tal cual los emite el modelo). */
+	readonly argumentsJson: string;
+}
+
+export interface IChatMessage {
+	role: ChatRole;
+	content: string;
+	/** Solo en mensajes 'assistant' que invocan herramientas. */
+	toolCalls?: IToolCall[];
+	/** Solo en mensajes 'tool' (resultado de una herramienta). */
+	toolCallId?: string;
+}
+
+export interface IToolDefinition {
+	readonly name: string;
+	readonly description: string;
+	/** JSON Schema de los parámetros. */
+	readonly parameters: object;
+}
+
+/** Eventos que el provider emite mientras streamea la respuesta. */
+export type AgentStreamEvent =
+	| { type: 'text'; delta: string }
+	| { type: 'reasoning'; delta: string }
+	| { type: 'toolCall'; call: IToolCall }
+	| { type: 'usage'; inputTokens?: number; outputTokens?: number };
+
+export interface IProviderRequest {
+	/** Credencial ya resuelta (API key u OAuth bearer token). */
+	readonly credential: ICredential;
+	readonly baseUrl?: string;
+	readonly model: string;
+	readonly system?: string;
+	readonly messages: IChatMessage[];
+	readonly tools?: IToolDefinition[];
+	readonly maxTokens?: number;
+}
+
+export interface IProviderResult {
+	/** Mensaje 'assistant' final (texto + toolCalls si hubo). */
+	readonly message: IChatMessage;
+	readonly stopReason?: string;
+}
+
+/** Un adaptador de PROTOCOLO (openai-compatible, anthropic, …). Pocos; los providers son datos. */
+export interface ILLMProvider {
+	readonly id: string;
+	streamChat(req: IProviderRequest, onEvent: (e: AgentStreamEvent) => void, token: CancellationToken): Promise<IProviderResult>;
+}
+
+/** Eventos de alto nivel que emite el agent loop hacia la UI/consumidor. */
+export type AgentLoopEvent =
+	| { type: 'text'; delta: string }
+	| { type: 'reasoning'; delta: string }
+	| { type: 'toolStart'; id: string; name: string; argumentsJson: string }
+	| { type: 'toolResult'; id: string; name: string; result: string; isError: boolean }
+	| { type: 'usage'; inputTokens?: number; outputTokens?: number }
+	| { type: 'done'; reason?: string }
+	| { type: 'error'; message: string };
diff --git a/src/vs/workbench/contrib/openideAgent/common/openidePkce.ts b/src/vs/workbench/contrib/openideAgent/common/openidePkce.ts
