@@ -0,0 +1,115 @@
+/*---------------------------------------------------------------------------------------------
+ *  OpenIDE — servicio del motor agéntico: maneja providers, API keys (SecretStorage),
+ *  y corre el agent loop (model → tool → model) con streaming.
+ *--------------------------------------------------------------------------------------------*/
+
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { IRequestService } from '../../../../platform/request/common/request.js';
+import { ISecretStorageService } from '../../../../platform/secrets/common/secrets.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { AgentLoopEvent, IChatMessage, ILLMProvider } from '../common/openideAgentTypes.js';
+import { AnthropicProvider } from '../common/providers/anthropicProvider.js';
+import { OpenAICompatibleProvider } from '../common/providers/openaiProvider.js';
+import { OpenideToolRegistry } from './openideTools.js';
+
+export const IOpenideAgentService = createDecorator<IOpenideAgentService>('openideAgentService');
+
+export interface IOpenideAgentService {
+	readonly _serviceBrand: undefined;
+	setApiKey(providerId: string, key: string): Promise<void>;
+	hasApiKey(providerId: string): Promise<boolean>;
+	runAgent(prompt: string, onEvent: (e: AgentLoopEvent) => void, token?: CancellationToken): Promise<void>;
+}
+
+const SECRET_PREFIX = 'openide.agent.apiKey.';
+const MAX_ITERATIONS = 12;
+const SYSTEM_PROMPT = `Sos el asistente de OpenIDE, un editor de código basado en VS Code. Ayudás al usuario con tareas de programación de forma concisa y directa. Tenés herramientas para leer archivos y listar directorios del workspace: usalas cuando necesites contexto real del proyecto en vez de inventar. Respondé en el idioma del usuario.`;
+
+export class OpenideAgentService extends Disposable implements IOpenideAgentService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private readonly providers = new Map<string, ILLMProvider>();
+	private readonly tools: OpenideToolRegistry;
+
+	constructor(
+		@IRequestService requestService: IRequestService,
+		@ISecretStorageService private readonly secretStorage: ISecretStorageService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@IFileService fileService: IFileService,
+		@IWorkspaceContextService contextService: IWorkspaceContextService,
+	) {
+		super();
+		this.providers.set('anthropic', new AnthropicProvider(requestService));
+		this.providers.set('openai', new OpenAICompatibleProvider(requestService));
+		this.tools = new OpenideToolRegistry(fileService, contextService);
+	}
+
+	async setApiKey(providerId: string, key: string): Promise<void> {
+		await this.secretStorage.set(SECRET_PREFIX + providerId, key);
+	}
+
+	async hasApiKey(providerId: string): Promise<boolean> {
+		return !!(await this.secretStorage.get(SECRET_PREFIX + providerId));
+	}
+
+	async runAgent(prompt: string, onEvent: (e: AgentLoopEvent) => void, token: CancellationToken = CancellationToken.None): Promise<void> {
+		try {
+			const providerId = this.configurationService.getValue<string>('openide.agent.provider') || 'anthropic';
+			const provider = this.providers.get(providerId);
+			if (!provider) {
+				onEvent({ type: 'error', message: `Provider desconocido: ${providerId}` });
+				return;
+			}
+			const apiKey = await this.secretStorage.get(SECRET_PREFIX + providerId);
+			if (!apiKey) {
+				onEvent({ type: 'error', message: `Falta la API key de "${providerId}". Ejecutá "OpenIDE Agent: Configurar API key".` });
+				return;
+			}
+			const model = this.configurationService.getValue<string>('openide.agent.model') || (providerId === 'anthropic' ? 'claude-sonnet-4-5' : 'gpt-4o');
+			const baseUrl = this.configurationService.getValue<string>('openide.agent.baseUrl') || undefined;
+
+			const messages: IChatMessage[] = [{ role: 'user', content: prompt }];
+			const toolDefs = this.tools.getDefinitions();
+
+			for (let i = 0; i < MAX_ITERATIONS; i++) {
+				if (token.isCancellationRequested) {
+					return;
+				}
+				const result = await provider.streamChat(
+					{ apiKey, baseUrl, model, system: SYSTEM_PROMPT, messages, tools: toolDefs },
+					ev => {
+						if (ev.type === 'text') { onEvent({ type: 'text', delta: ev.delta }); }
+						else if (ev.type === 'reasoning') { onEvent({ type: 'reasoning', delta: ev.delta }); }
+						else if (ev.type === 'usage') { onEvent({ type: 'usage', inputTokens: ev.inputTokens, outputTokens: ev.outputTokens }); }
+					},
+					token,
+				);
+
+				messages.push(result.message);
+				const calls = result.message.toolCalls;
+				if (!calls || !calls.length) {
+					onEvent({ type: 'done', reason: result.stopReason });
+					return;
+				}
+
+				for (const call of calls) {
+					onEvent({ type: 'toolStart', id: call.id, name: call.name, argumentsJson: call.argumentsJson });
+					const out = await this.tools.invoke(call.name, call.argumentsJson, token);
+					onEvent({ type: 'toolResult', id: call.id, name: call.name, result: out, isError: out.startsWith('Error') });
+					messages.push({ role: 'tool', toolCallId: call.id, content: out });
+				}
+			}
+			onEvent({ type: 'done', reason: 'max_iterations' });
+		} catch (e) {
+			onEvent({ type: 'error', message: e instanceof Error ? e.message : String(e) });
+		}
+	}
+}
+
+registerSingleton(IOpenideAgentService, OpenideAgentService, InstantiationType.Delayed);
