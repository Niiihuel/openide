index 00000000..78f8a22e
--- /dev/null
+++ b/src/vs/workbench/contrib/openideAgent/common/openideProviderCatalog.ts
@@ -0,0 +1,100 @@
+/*---------------------------------------------------------------------------------------------
+ *  OpenIDE — catálogo de proveedores como DATOS. La idea: pocos "protocolos" (código) y
+ *  muchos providers (data). Sumar un provider = una entrada acá o un custom en settings.
+ *--------------------------------------------------------------------------------------------*/
+
+export type ProtocolId = 'openai' | 'anthropic';
+export type AuthKind = 'apiKey' | 'oauth';
+
+export interface IOAuthConfig {
+	/** 'pkce' = authorize code + PKCE (el usuario pega el código); 'device' = device code (polling). */
+	readonly flow: 'pkce' | 'device';
+	readonly authorizationUrl?: string;
+	readonly deviceAuthorizationUrl?: string;
+	readonly tokenUrl: string;
+	readonly clientId: string;
+	readonly scopes: string[];
+	/** Redirect URI registrada en el provider (para PKCE-paste suele mostrar el código). */
+	readonly redirectUri?: string;
+	/** Algunos token endpoints esperan JSON en vez de form-urlencoded. */
+	readonly tokenContentType?: 'json' | 'form';
+}
+
+export interface IProviderEntry {
+	readonly id: string;
+	readonly label: string;
+	readonly protocol: ProtocolId;
+	readonly baseUrl?: string;
+	readonly auth: AuthKind;
+	readonly defaultModel?: string;
+	readonly models?: string[];
+	readonly oauth?: IOAuthConfig;
+	readonly custom?: boolean;
+}
+
+/**
+ * Providers built-in. La mayoría hablan el protocolo OpenAI-compatible (estándar de facto),
+ * así que sumar uno nuevo suele ser solo {id, label, baseUrl}.
+ */
+export const OPENIDE_BUILTIN_PROVIDERS: ReadonlyArray<IProviderEntry> = [
+	{ id: 'anthropic', label: 'Anthropic (Claude · API key)', protocol: 'anthropic', auth: 'apiKey', defaultModel: 'claude-sonnet-4-5' },
+	{
+		id: 'claude-oauth', label: 'Claude (suscripción Pro/Max · OAuth)', protocol: 'anthropic', auth: 'oauth', defaultModel: 'claude-sonnet-4-5',
+		oauth: {
+			flow: 'pkce',
+			authorizationUrl: 'https://claude.ai/oauth/authorize',
+			tokenUrl: 'https://console.anthropic.com/v1/oauth/token',
+			clientId: '9d1c250a-e61b-44d9-88ed-5944d1962f5e',
+			scopes: ['org:create_api_key', 'user:profile', 'user:inference'],
+			redirectUri: 'https://console.anthropic.com/oauth/code/callback',
+			tokenContentType: 'json',
+		},
+	},
+	{ id: 'openai', label: 'OpenAI', protocol: 'openai', baseUrl: 'https://api.openai.com/v1', auth: 'apiKey', defaultModel: 'gpt-4o' },
+	{ id: 'openrouter', label: 'OpenRouter', protocol: 'openai', baseUrl: 'https://openrouter.ai/api/v1', auth: 'apiKey', defaultModel: 'openai/gpt-4o' },
+	{ id: 'groq', label: 'Groq', protocol: 'openai', baseUrl: 'https://api.groq.com/openai/v1', auth: 'apiKey', defaultModel: 'llama-3.3-70b-versatile' },
+	{ id: 'deepseek', label: 'DeepSeek', protocol: 'openai', baseUrl: 'https://api.deepseek.com', auth: 'apiKey', defaultModel: 'deepseek-chat' },
+	{ id: 'mistral', label: 'Mistral', protocol: 'openai', baseUrl: 'https://api.mistral.ai/v1', auth: 'apiKey', defaultModel: 'mistral-large-latest' },
+	{ id: 'xai', label: 'xAI (Grok)', protocol: 'openai', baseUrl: 'https://api.x.ai/v1', auth: 'apiKey', defaultModel: 'grok-2-latest' },
+	{ id: 'gemini', label: 'Google Gemini', protocol: 'openai', baseUrl: 'https://generativelanguage.googleapis.com/v1beta/openai', auth: 'apiKey', defaultModel: 'gemini-2.0-flash' },
+	{ id: 'together', label: 'Together', protocol: 'openai', baseUrl: 'https://api.together.xyz/v1', auth: 'apiKey', defaultModel: 'meta-llama/Llama-3.3-70B-Instruct-Turbo' },
+	{ id: 'ollama', label: 'Ollama (local)', protocol: 'openai', baseUrl: 'http://localhost:11434/v1', auth: 'apiKey', defaultModel: 'llama3.2' },
+];
+
+/** Normaliza un provider custom venido de settings (tolerante a campos faltantes). */
+function normalizeCustom(raw: any): IProviderEntry | undefined {
+	if (!raw || typeof raw.id !== 'string' || !raw.id) {
+		return undefined;
+	}
+	const protocol: ProtocolId = raw.protocol === 'anthropic' ? 'anthropic' : 'openai';
+	return {
+		id: raw.id,
+		label: typeof raw.label === 'string' && raw.label ? raw.label : raw.id,
+		protocol,
+		baseUrl: typeof raw.baseUrl === 'string' ? raw.baseUrl : undefined,
+		auth: raw.auth === 'oauth' ? 'oauth' : 'apiKey',
+		defaultModel: typeof raw.defaultModel === 'string' ? raw.defaultModel : undefined,
+		custom: true,
+	};
+}
+
+/** Catálogo final = built-in + custom (los custom con el mismo id pisan al built-in). */
+export function resolveProviders(custom: any[] | undefined): IProviderEntry[] {
+	const map = new Map<string, IProviderEntry>();
+	for (const p of OPENIDE_BUILTIN_PROVIDERS) {
+		map.set(p.id, p);
+	}
+	if (Array.isArray(custom)) {
+		for (const raw of custom) {
+			const entry = normalizeCustom(raw);
+			if (entry) {
+				map.set(entry.id, entry);
+			}
+		}
+	}
+	return [...map.values()];
+}
+
+export function findProvider(custom: any[] | undefined, id: string): IProviderEntry | undefined {
+	return resolveProviders(custom).find(p => p.id === id);
+}
diff --git a/src/vs/workbench/contrib/openideAgent/common/openideSse.ts b/src/vs/workbench/contrib/openideAgent/common/openideSse.ts
