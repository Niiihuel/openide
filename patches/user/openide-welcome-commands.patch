+		{ n: '2', title: localize('openide.overlay.step2.title', "Conectá con GitHub"), desc: localize('openide.overlay.step2.desc', "Iniciá sesión para clonar, sincronizar y publicar tus repositorios."), button: localize('openide.overlay.step2.btn', "Conectar con GitHub"), command: 'openide.signInWithGitHub' },
+		{ n: '3', title: localize('openide.overlay.step3.title', "Importá desde VS Code"), desc: localize('openide.overlay.step3.desc', "Traé tus configuraciones, atajos y extensiones de VS Code."), button: localize('openide.overlay.step3.btn', "Importar de VS Code"), command: 'openide.importFromVSCode' },
+	];
+
+	for (const step of steps) {
+		const row = append(card, $('div'));
+		row.style.cssText = 'display:flex;gap:16px;align-items:center;padding:16px;border:1px solid var(--vscode-widget-border, #303031);border-radius:8px;';
+
+		const badge = append(row, $('div'));
+		badge.style.cssText = 'flex:0 0 32px;height:32px;width:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--vscode-button-background, #0e639c);color:var(--vscode-button-foreground, #ffffff);font-weight:600;';
+		badge.textContent = step.n;
+
+		const text = append(row, $('div'));
+		text.style.cssText = 'flex:1;display:flex;flex-direction:column;gap:2px;min-width:0;';
