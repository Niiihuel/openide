+		btn.style.cssText = 'flex:0 0 auto;cursor:pointer;border:none;border-radius:4px;padding:6px 14px;background:var(--vscode-button-secondaryBackground, #3a3d41);color:var(--vscode-button-secondaryForeground, #ffffff);';
