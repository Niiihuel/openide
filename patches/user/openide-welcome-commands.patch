+			title: localize2('openide.showWelcome.title', 'OpenIDE: Mostrar bienvenida'),
+			category: Categories.Help,
+			f1: true,
+		});
+	}
+
+	run(accessor: ServicesAccessor) {
+		showOpenIDEWelcomeOverlay(accessor.get(ICommandService));
+	}
+});
