+// OpenIDE: inyecta un SVG (data URI base64) como nodo inline, de forma segura
+// (sin innerHTML/Trusted Types). Asi los iconos monocromos heredan el color del tema.
+function openideAppendSvg(parent: HTMLElement, dataUri: string, size: number): void {
+	try {
+		const svgStr = atob(dataUri.slice(dataUri.indexOf(',') + 1));
+		const doc = new DOMParser().parseFromString(svgStr, 'image/svg+xml');
+		if (doc.getElementsByTagName('parsererror').length) {
+			return;
+		}
+		const svgEl = mainWindow.document.importNode(doc.documentElement, true) as unknown as HTMLElement;
+		svgEl.style.width = `${size}px`;
+		svgEl.style.height = `${size}px`;
+		parent.appendChild(svgEl);
+	} catch {
+		// ignorar logos invalidos
+	}
+}
