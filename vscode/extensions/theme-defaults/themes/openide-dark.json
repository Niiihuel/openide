{
	"$schema": "vscode://schemas/color-theme",
	"name": "OpenIDE Dark",
	"type": "dark",
	"colors": {
		"openide.workbenchBackground": "#0f0f0f",
		"openide.islandBackground": "#171717",
		"openide.shellSeparator": "#ffffff1f",

		"foreground": "#cccccc",
		"disabledForeground": "#7a7a7a",
		"descriptionForeground": "#9a9a9a",
		"errorForeground": "#d18a8a",
		"focusBorder": "#525252",
		"icon.foreground": "#c5c5c5",
		"selection.background": "#3a3a3a",
		"widget.border": "#2a2a2a",
		"widget.shadow": "#00000066",
		"sash.hoverBorder": "#5a5a5a",

		"textLink.foreground": "#bdbdbd",
		"textLink.activeForeground": "#e6e6e6",
		"textPreformat.foreground": "#d4d4d4",
		"textPreformat.background": "#2a2a2a",
		"textBlockQuote.background": "#1c1c1c",
		"textBlockQuote.border": "#3a3a3a",
		"textCodeBlock.background": "#1c1c1c",
		"textSeparator.foreground": "#2a2a2a",

		"button.background": "#eeb266",
		"button.foreground": "#1f1a13",
		"button.hoverBackground": "#f3c07e",
		"button.secondaryBackground": "#262626",
		"button.secondaryForeground": "#e0e0e0",
		"button.secondaryHoverBackground": "#303030",
		"button.border": "#ffffff14",

		"badge.background": "#454545",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#8a8a8a",

		// Text fields are read by their fill, not by an outline: `input.border` was the hairline
		// rectangle drawn around every search / find / quick-open / settings box in the product
		// (the color registry defaults it to null on dark, so this theme was its only source).
		// The fill is raised one step above the widget surfaces it sits on (#1c1c1c for
		// quickInput / editorWidget / menu, #171717 for editor / sideBar / panel) so the field
		// stays locatable without the border. High-contrast themes keep their contrastBorder.
		"input.background": "#212121",
		"input.foreground": "#cccccc",
		"input.border": "#00000000",
		"input.placeholderForeground": "#7e7e7e",
		"inputOption.activeBackground": "#5a5a5a55",
		"inputOption.activeBorder": "#5a5a5a",
		"inputOption.activeForeground": "#ffffff",
		"inputValidation.errorBackground": "#3a1f1f",
		"inputValidation.errorBorder": "#7a4a4a",
		"inputValidation.warningBackground": "#3a341f",
		"inputValidation.warningBorder": "#7a724a",

		"dropdown.background": "#1c1c1c",
		"dropdown.listBackground": "#1c1c1c",
		"dropdown.foreground": "#cccccc",
		"dropdown.border": "#2e2e2e",

		"checkbox.background": "#1c1c1c",
		"checkbox.border": "#2e2e2e",
		"checkbox.foreground": "#cccccc",

		"scrollbar.shadow": "#00000000",
		"scrollbarSlider.background": "#4a4a4a55",
		"scrollbarSlider.hoverBackground": "#5a5a5a77",
		"scrollbarSlider.activeBackground": "#6a6a6a88",

		"editor.background": "#171717",
		"editor.foreground": "#d4d4d4",
		"editorLineNumber.foreground": "#565656",
		"editorLineNumber.activeForeground": "#b4b4b4",
		"editorCursor.foreground": "#d0d0d0",
		"editor.selectionBackground": "#303030",
		"editor.inactiveSelectionBackground": "#262626",
		"editor.selectionHighlightBackground": "#2a2a2a80",
		"editor.wordHighlightBackground": "#2a2a2a80",
		"editor.wordHighlightStrongBackground": "#33333380",
		"editor.findMatchBackground": "#5a5a5a99",
		"editor.findMatchHighlightBackground": "#48484866",
		"editor.lineHighlightBackground": "#1b1b1b",
		"editor.lineHighlightBorder": "#00000000",
		"editor.rangeHighlightBackground": "#2a2a2a44",
		"editorWhitespace.foreground": "#3a3a3a",
		"editorIndentGuide.background1": "#262626",
		"editorIndentGuide.activeBackground1": "#454545",
		"editorRuler.foreground": "#262626",
		"editorBracketMatch.background": "#3a3a3a",
		"editorBracketMatch.border": "#5a5a5a",
		"editorOverviewRuler.border": "#00000000",

		"editorWidget.background": "#1c1c1c",
		"editorWidget.border": "#2e2e2e",
		"editorSuggestWidget.background": "#1c1c1c",
		"editorSuggestWidget.border": "#2e2e2e",
		"editorSuggestWidget.selectedBackground": "#333333",
		"editorSuggestWidget.highlightForeground": "#e6e6e6",
		"editorHoverWidget.background": "#1c1c1c",
		"editorHoverWidget.border": "#2e2e2e",

		"peekViewEditor.background": "#1a1a1a",
		"peekViewResult.background": "#181818",
		"peekViewTitle.background": "#1c1c1c",
		"peekView.border": "#3a3a3a",
		"peekViewEditor.matchHighlightBackground": "#5a5a5a66",
		"peekViewResult.matchHighlightBackground": "#5a5a5a66",

		"sideBar.background": "#171717",
		"sideBar.foreground": "#c2c2c2",
		"sideBarTitle.foreground": "#bdbdbd",
		"sideBarSectionHeader.background": "#171717",
		"sideBarSectionHeader.foreground": "#c2c2c2",
		"sideBarSectionHeader.border": "#00000000",

		"list.activeSelectionBackground": "#2e2e2e",
		"list.activeSelectionForeground": "#ffffff",
		"list.inactiveSelectionBackground": "#262626",
		"list.inactiveSelectionForeground": "#cccccc",
		"list.hoverBackground": "#2c2c2c",
		"list.focusBackground": "#383838",
		"list.focusOutline": "#5a5a5a",
		"list.highlightForeground": "#e6e6e6",
		"list.errorForeground": "#d18a8a",
		"list.warningForeground": "#c9bd8a",
		"tree.indentGuidesStroke": "#2e2e2e",

		"activityBar.background": "#0f0f0f",
		"activityBar.foreground": "#d4d4d4",
		"activityBar.inactiveForeground": "#6e6e6e",
		"activityBar.border": "#00000000",
		"activityBar.activeBorder": "#cfcfcf",
		"activityBarBadge.background": "#5a5a5a",
		"activityBarBadge.foreground": "#ffffff",

		"titleBar.activeBackground": "#0f0f0f",
		"titleBar.activeForeground": "#cccccc",
		"titleBar.inactiveBackground": "#0f0f0f",
		"titleBar.inactiveForeground": "#7e7e7e",
		"titleBar.border": "#00000000",

		"statusBar.background": "#0f0f0f",
		"statusBar.foreground": "#b4b4b4",
		"statusBar.border": "#ffffff1f",
		"statusBar.noFolderBackground": "#0f0f0f",
		"statusBar.noFolderForeground": "#b4b4b4",
		"statusBar.debuggingBackground": "#3a3a3a",
		"statusBar.debuggingForeground": "#ffffff",
		"statusBar.focusBorder": "#5a5a5a",
		"statusBarItem.hoverBackground": "#ffffff14",
		"statusBarItem.hoverForeground": "#ffffff",
		"statusBarItem.prominentBackground": "#3a3a3a",
		"statusBarItem.remoteBackground": "#333333",
		"statusBarItem.remoteForeground": "#ffffff",
		"statusBarItem.focusBorder": "#5a5a5a",

		"editorGroup.border": "#00000000",
		"editorGroupHeader.tabsBackground": "#171717",
		"editorGroupHeader.tabsBorder": "#00000000",
		"tab.activeBackground": "#1f1f1f",
		"tab.activeForeground": "#ffffff",
		"tab.inactiveBackground": "#171717",
		"tab.inactiveForeground": "#8e8e8e",
		"tab.border": "#00000000",
		"tab.activeBorder": "#1f1f1f",
		"tab.activeBorderTop": "#cfcfcf",
		"tab.hoverBackground": "#1f1f1f",
		"tab.unfocusedActiveForeground": "#bdbdbd",

		"panel.background": "#171717",
		"panel.border": "#00000000",
		// Same field, different host: this only restated `input.border` for inputs inside the
		// panel, so leaving it would keep the rectangle alive in the terminal / output filters.
		"panelInput.border": "#00000000",
		"panelTitle.activeForeground": "#ffffff",
		"panelTitle.activeBorder": "#cfcfcf",
		"panelTitle.inactiveForeground": "#8e8e8e",
		"panelSectionHeader.background": "#171717",

		"minimap.background": "#171717",
		"minimapSlider.background": "#4a4a4a44",

		"breadcrumb.foreground": "#8e8e8e",
		"breadcrumb.focusForeground": "#cccccc",
		"breadcrumb.activeSelectionForeground": "#e6e6e6",
		"breadcrumbPicker.background": "#1c1c1c",

		"pickerGroup.foreground": "#9a9a9a",
		"pickerGroup.border": "#2e2e2e",
		"quickInput.background": "#1c1c1c",
		"quickInput.foreground": "#cccccc",
		"quickInputList.focusBackground": "#383838",

		"menu.background": "#1c1c1c",
		"menu.foreground": "#cccccc",
		"menu.selectionBackground": "#383838",
		"menu.selectionForeground": "#ffffff",
		"menu.border": "#2e2e2e",
		"menu.separatorBackground": "#2e2e2e",
		"menubar.selectionBackground": "#2e2e2e",

		"notificationCenterHeader.background": "#1c1c1c",
		"notificationCenterHeader.foreground": "#cccccc",
		"notifications.background": "#1c1c1c",
		"notifications.border": "#2a2a2a",
		"notifications.foreground": "#cccccc",

		"keybindingLabel.background": "#2a2a2a",
		"keybindingLabel.foreground": "#cccccc",
		"keybindingLabel.border": "#3a3a3a",
		"keybindingLabel.bottomBorder": "#3a3a3a",

		"settings.headerForeground": "#ffffff",
		"settings.modifiedItemIndicator": "#8a8a8a",
		"settings.dropdownBackground": "#1c1c1c",
		"settings.dropdownBorder": "#2e2e2e",

		"welcomePage.tileBackground": "#1c1c1c",
		"welcomePage.tileHoverBackground": "#262626",
		"welcomePage.progress.foreground": "#8a8a8a",

		"terminal.background": "#171717",
		"terminal.foreground": "#cccccc",
		"terminalCursor.foreground": "#d0d0d0",
		"terminal.ansiBlack": "#2a2a2a",
		"terminal.ansiBrightBlack": "#5a5a5a",
		"terminal.ansiWhite": "#cfcfcf",
		"terminal.ansiBrightWhite": "#ffffff",
		"terminal.ansiRed": "#c98a8a",
		"terminal.ansiBrightRed": "#d9a0a0",
		"terminal.ansiGreen": "#9fae93",
		"terminal.ansiBrightGreen": "#b3c0a6",
		"terminal.ansiYellow": "#cabf94",
		"terminal.ansiBrightYellow": "#dcd2aa",
		"terminal.ansiBlue": "#93a0ae",
		"terminal.ansiBrightBlue": "#a6b3c0",
		"terminal.ansiMagenta": "#b298ad",
		"terminal.ansiBrightMagenta": "#c4adbe",
		"terminal.ansiCyan": "#94bdbd",
		"terminal.ansiBrightCyan": "#aacccc",

		"gitDecoration.modifiedResourceForeground": "#b0b0b0",
		"gitDecoration.deletedResourceForeground": "#c98a8a",
		"gitDecoration.untrackedResourceForeground": "#9fae93",
		"gitDecoration.addedResourceForeground": "#9fae93",

		// Taken from the inline review, which already paints an agent diff INSIDE an editor
		// (openideChat.css `.openide-review-added-line`): the tint is the accent MIXED INTO the
		// editor background, not a translucent overlay. That matters here — the diff editor
		// stacks its line background and its word background, and two translucent layers came
		// out far heavier than the same green anywhere else in the product. Opaque values
		// cannot stack, so a fully added line lands on exactly the review's tone and a changed
		// word inside a modified line gets the next step up.
		"diffEditor.insertedLineBackground": "#1b332b",
		"diffEditor.insertedTextBackground": "#1f4839",
		"diffEditor.removedLineBackground": "#3c1f28",
		"diffEditor.removedTextBackground": "#4f2330",
		"diffEditorGutter.insertedLineBackground": "#1b332b",
		"diffEditorGutter.removedLineBackground": "#3c1f28",
		"diffEditorOverview.insertedForeground": "#2b9771cc",
		"diffEditorOverview.removedForeground": "#c23f60cc",
		"diffEditor.unchangedRegionBackground": "#00000000",

		"gitDecoration.ignoredResourceForeground": "#5a5a5a",
		"gitDecoration.conflictingResourceForeground": "#cabf94",

		"editorGutter.modifiedBackground": "#7a7a7a",
		"editorGutter.addedBackground": "#5a5a5a",
		"editorGutter.deletedBackground": "#8a5a5a",

		"editorError.foreground": "#cf8a8a",
		"editorWarning.foreground": "#cabf94",
		"editorInfo.foreground": "#93a0ae",

		"editorBracketHighlight.foreground1": "#bdbdbd",
		"editorBracketHighlight.foreground2": "#9a9a9a",
		"editorBracketHighlight.foreground3": "#7e7e7e",
		"editorBracketHighlight.foreground4": "#bdbdbd",
		"editorBracketHighlight.foreground5": "#9a9a9a",
		"editorBracketHighlight.foreground6": "#7e7e7e",
		"editorBracketHighlight.unexpectedBracket.foreground": "#cf8a8a"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a737d", "fontStyle": "italic" } },
		{ "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#c678dd" } },
		{ "scope": ["keyword.operator"], "settings": { "foreground": "#56b6c2" } },
		{ "scope": ["string", "string.quoted", "punctuation.definition.string", "string.template"], "settings": { "foreground": "#98c379" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#d19a66" } },
		{ "scope": ["variable", "variable.other", "meta.definition.variable.name", "support.variable"], "settings": { "foreground": "#e06c75" } },
		{ "scope": ["variable.parameter"], "settings": { "foreground": "#d4d4d4" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#61afef" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#e5c07b" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#e06c75" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#d19a66" } },
		{ "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#7f8894" } },
		{ "scope": ["variable.language", "support.type.property-name"], "settings": { "foreground": "#e06c75" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#e06c75" } },
		{ "scope": ["markup.heading"], "settings": { "foreground": "#61afef", "fontStyle": "bold" } },
		{ "scope": ["markup.bold"], "settings": { "foreground": "#d19a66", "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#98c379" } }
	],
	"semanticTokenColors": {
		"class": "#e5c07b",
		"interface": "#e5c07b",
		"enum": "#e5c07b",
		"enumMember": "#d19a66",
		"struct": "#e5c07b",
		"type": "#e5c07b",
		"typeParameter": "#e5c07b",
		"namespace": "#e5c07b",
		"function": "#61afef",
		"method": "#61afef",
		"macro": "#61afef",
		"property": "#e06c75",
		"variable": "#d4d4d4",
		"parameter": "#d4d4d4",
		"keyword": "#c678dd"
	},
	"semanticHighlighting": true
}
