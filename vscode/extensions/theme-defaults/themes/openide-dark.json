		"editorGroupHeader.tabsBackground": "#181818",
		"editorGroupHeader.tabsBorder": "#00000000",
		"tab.activeBackground": "#1f1f1f",
		"tab.activeForeground": "#ffffff",
		"tab.inactiveBackground": "#181818",
		"tab.inactiveForeground": "#8e8e8e",
		"tab.border": "#00000000",
		"tab.activeBorder": "#1f1f1f",
		"tab.activeBorderTop": "#cfcfcf",
		"tab.hoverBackground": "#1f1f1f",
		"tab.unfocusedActiveForeground": "#bdbdbd",

		"panel.background": "#181818",
		"panel.border": "#00000000",
		// Same field, different host: this only restated `input.border` for inputs inside the
		// panel, so leaving it would keep the rectangle alive in the terminal / output filters.
		"panelInput.border": "#00000000",
		"panelTitle.activeForeground": "#ffffff",
		"panelTitle.activeBorder": "#cfcfcf",
		"panelTitle.inactiveForeground": "#8e8e8e",
		"panelSectionHeader.background": "#171717",

		"minimap.background": "#171717",
		"minimapSlider.background": "#4a4a4a44",

		"breadcrumb.foreground": "#8e8e8e",
		"breadcrumb.focusForeground": "#cccccc",
		"breadcrumb.activeSelectionForeground": "#e6e6e6",
		"breadcrumbPicker.background": "#1c1c1c",

		"pickerGroup.foreground": "#9a9a9a",
		"pickerGroup.border": "#2e2e2e",
		"quickInput.background": "#2d2d2d",
		"quickInput.foreground": "#ededed",
		"quickInputList.focusBackground": "#3d3d3d",

		"menu.background": "#2d2d2d",
		"menu.foreground": "#ededed",
		"menu.selectionBackground": "#3d3d3d",
		"menu.selectionForeground": "#ffffff",
		"menu.border": "#464646",
		"menu.separatorBackground": "#353535",
		"menubar.selectionBackground": "#2e2e2e",

		"notificationCenterHeader.background": "#232323",
		"notificationCenterHeader.foreground": "#cccccc",
		"notifications.background": "#232323",
		"notifications.border": "#353535",
		"notifications.foreground": "#cccccc",

		"keybindingLabel.background": "#2a2a2a",
		"keybindingLabel.foreground": "#cccccc",
		"keybindingLabel.border": "#3a3a3a",
		"keybindingLabel.bottomBorder": "#3a3a3a",

		"settings.headerForeground": "#ffffff",
		"settings.modifiedItemIndicator": "#8a8a8a",
		"settings.dropdownBackground": "#2a2a2a",
		"settings.dropdownBorder": "#464646",

		"welcomePage.tileBackground": "#1c1c1c",
		"welcomePage.tileHoverBackground": "#262626",
		"welcomePage.progress.foreground": "#8a8a8a",

		"terminal.background": "#181818",
		"terminal.foreground": "#cccccc",
		"terminalCursor.foreground": "#d0d0d0",
		"terminal.ansiBlack": "#2a2a2a",
		"terminal.ansiBrightBlack": "#5a5a5a",
		"terminal.ansiWhite": "#cfcfcf",
		"terminal.ansiBrightWhite": "#ffffff",
		"terminal.ansiRed": "#c98a8a",
		"terminal.ansiBrightRed": "#d9a0a0",
		"terminal.ansiGreen": "#9fae93",
		"terminal.ansiBrightGreen": "#b3c0a6",
		"terminal.ansiYellow": "#cabf94",
		"terminal.ansiBrightYellow": "#dcd2aa",
		"terminal.ansiBlue": "#93a0ae",
		"terminal.ansiBrightBlue": "#a6b3c0",
		"terminal.ansiMagenta": "#b298ad",
		"terminal.ansiBrightMagenta": "#c4adbe",
		"terminal.ansiCyan": "#94bdbd",
		"terminal.ansiBrightCyan": "#aacccc",

		"gitDecoration.modifiedResourceForeground": "#b0b0b0",
		"gitDecoration.deletedResourceForeground": "#c98a8a",
		"gitDecoration.untrackedResourceForeground": "#9fae93",
		"gitDecoration.addedResourceForeground": "#9fae93",

		// Taken from the inline review, which already paints an agent diff INSIDE an editor
		// (openideChat.css `.openide-review-added-line`): the tint is the accent MIXED INTO the
		// editor background, not a translucent overlay. That matters here — the diff editor
		// stacks its line background and its word background, and two translucent layers came
		// out far heavier than the same green anywhere else in the product. Opaque values
		// cannot stack, so a fully added line lands on exactly the review's tone and a changed
		// word inside a modified line gets the next step up.
		"diffEditor.insertedLineBackground": "#1b332b",
		"diffEditor.insertedTextBackground": "#1f4839",
		"diffEditor.removedLineBackground": "#3c1f28",
		"diffEditor.removedTextBackground": "#4f2330",
		"diffEditorGutter.insertedLineBackground": "#1b332b",
		"diffEditorGutter.removedLineBackground": "#3c1f28",
		"diffEditorOverview.insertedForeground": "#2b9771cc",
		"diffEditorOverview.removedForeground": "#c23f60cc",
		"diffEditor.unchangedRegionBackground": "#00000000",

		"gitDecoration.ignoredResourceForeground": "#5a5a5a",
		"gitDecoration.conflictingResourceForeground": "#cabf94",

		"editorGutter.modifiedBackground": "#7a7a7a",
		"editorGutter.addedBackground": "#5a5a5a",
		"editorGutter.deletedBackground": "#8a5a5a",

		"editorError.foreground": "#cf8a8a",
		"editorWarning.foreground": "#cabf94",
		"editorInfo.foreground": "#93a0ae",

	},
	"semanticHighlighting": true
