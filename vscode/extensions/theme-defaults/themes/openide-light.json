{
	"$schema": "vscode://schemas/color-theme",
	"name": "OpenIDE Light",
	"type": "light",
	"colors": {
		"openide.workbenchBackground": "#ededed",
		"openide.islandBackground": "#ffffff",
		"openide.shellSeparator": "#00000020",

		"foreground": "#1f1f1f",
		"disabledForeground": "#9a9a9a",
		"descriptionForeground": "#6a6a6a",
		"errorForeground": "#a85050",
		"focusBorder": "#9a9a9a",
		"icon.foreground": "#3a3a3a",
		"selection.background": "#d6d6d6",
		"widget.border": "#e2e2e2",
		"widget.shadow": "#00000014",
		"sash.hoverBorder": "#9a9a9a",

		"textLink.foreground": "#4a4a4a",
		"textLink.activeForeground": "#1f1f1f",
		"textPreformat.foreground": "#2a2a2a",
		"textPreformat.background": "#ededed",
		"textBlockQuote.background": "#f3f3f3",
		"textBlockQuote.border": "#d6d6d6",
		"textCodeBlock.background": "#f0f0f0",
		"textSeparator.foreground": "#d6d6d6",

		"button.background": "#e8a44f",
		"button.foreground": "#33250f",
		"button.hoverBackground": "#dd9840",
		"button.secondaryBackground": "#e6e6e6",
		"button.secondaryForeground": "#1f1f1f",
		"button.secondaryHoverBackground": "#dcdcdc",
		"button.border": "#00000014",

		"badge.background": "#6a6a6a",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#6a6a6a",

		// Text fields are read by their fill, not by an outline: `input.border` was the hairline
		// rectangle drawn around every search / find / quick-open / settings box in the product
		// (the color registry defaults it to null on light, so this theme was its only source).
		// The fill is recessed below the surfaces it sits on (#ffffff for editor / sideBar /
		// panel / menu, #f6f6f6 for quickInput / editorWidget) so the field stays locatable
		// without the border. High-contrast themes keep their contrastBorder.
		"input.background": "#f0f0f0",
		"input.foreground": "#1f1f1f",
		"input.border": "#00000000",
		"input.placeholderForeground": "#8a8a8a",
		"inputOption.activeBackground": "#9a9a9a44",
		"inputOption.activeBorder": "#9a9a9a",
		"inputOption.activeForeground": "#1f1f1f",
		"inputValidation.errorBackground": "#f6e0e0",
		"inputValidation.errorBorder": "#c08a8a",
		"inputValidation.warningBackground": "#f6f0d8",
		"inputValidation.warningBorder": "#c0b07a",

		"dropdown.background": "#ffffff",
		"dropdown.listBackground": "#ffffff",
		"dropdown.foreground": "#1f1f1f",
		"dropdown.border": "#d0d0d0",

		"checkbox.background": "#ffffff",
		"checkbox.border": "#c4c4c4",
		"checkbox.foreground": "#1f1f1f",

		"scrollbar.shadow": "#00000000",
		"scrollbarSlider.background": "#9a9a9a55",
		"scrollbarSlider.hoverBackground": "#8a8a8a77",
		"scrollbarSlider.activeBackground": "#7a7a7a88",

		"editor.background": "#ffffff",
		"editor.foreground": "#2a2a2a",
		"editorLineNumber.foreground": "#b0b0b0",
		"editorLineNumber.activeForeground": "#3a3a3a",
		"editorCursor.foreground": "#2a2a2a",
		"editor.selectionBackground": "#d4d4d4",
		"editor.inactiveSelectionBackground": "#e4e4e4",
		"editor.selectionHighlightBackground": "#dedede80",
		"editor.wordHighlightBackground": "#dedede80",
		"editor.wordHighlightStrongBackground": "#d0d0d080",
		"editor.findMatchBackground": "#bdbdbd99",
		"editor.findMatchHighlightBackground": "#cfcfcf66",
		"editor.lineHighlightBackground": "#f6f6f6",
		"editor.lineHighlightBorder": "#00000000",
		"editor.rangeHighlightBackground": "#ededed88",
		"editorWhitespace.foreground": "#cfcfcf",
		"editorIndentGuide.background1": "#e6e6e6",
		"editorIndentGuide.activeBackground1": "#b0b0b0",
		"editorRuler.foreground": "#e6e6e6",
		"editorBracketMatch.background": "#d6d6d6",
		"editorBracketMatch.border": "#9a9a9a",
		"editorOverviewRuler.border": "#00000000",

		"editorWidget.background": "#f6f6f6",
		"editorWidget.border": "#e2e2e2",
		"editorSuggestWidget.background": "#ffffff",
		"editorSuggestWidget.border": "#e2e2e2",
		"editorSuggestWidget.selectedBackground": "#e4e4e4",
		"editorSuggestWidget.highlightForeground": "#1f1f1f",
		"editorHoverWidget.background": "#f6f6f6",
		"editorHoverWidget.border": "#e2e2e2",

		"peekViewEditor.background": "#f6f6f6",
		"peekViewResult.background": "#f3f3f3",
		"peekViewTitle.background": "#ededed",
		"peekView.border": "#d6d6d6",

		"sideBar.background": "#ffffff",
		"sideBar.foreground": "#3a3a3a",
		"sideBarTitle.foreground": "#3a3a3a",
		"sideBarSectionHeader.background": "#ffffff",
		"sideBarSectionHeader.foreground": "#3a3a3a",
		"sideBarSectionHeader.border": "#00000000",

		"list.activeSelectionBackground": "#e0e0e0",
		"list.activeSelectionForeground": "#1f1f1f",
		"list.inactiveSelectionBackground": "#e8e8e8",
		"list.inactiveSelectionForeground": "#1f1f1f",
		"list.hoverBackground": "#ededed",
		"list.focusBackground": "#e0e0e0",
		"list.focusOutline": "#9a9a9a",
		"list.highlightForeground": "#1f1f1f",
		"list.errorForeground": "#a85050",
		"list.warningForeground": "#8a7a3a",
		"tree.indentGuidesStroke": "#d0d0d0",

		"activityBar.background": "#ededed",
		"activityBar.foreground": "#2a2a2a",
		"activityBar.inactiveForeground": "#8a8a8a",
		"activityBar.border": "#00000000",
		"activityBar.activeBorder": "#2a2a2a",
		"activityBarBadge.background": "#5a5a5a",
		"activityBarBadge.foreground": "#ffffff",

		"titleBar.activeBackground": "#ededed",
		"titleBar.activeForeground": "#1f1f1f",
		"titleBar.inactiveBackground": "#ededed",
		"titleBar.inactiveForeground": "#8a8a8a",
		"titleBar.border": "#00000000",

		"statusBar.background": "#ededed",
		"statusBar.foreground": "#3a3a3a",
		"statusBar.border": "#00000020",
		"statusBar.noFolderBackground": "#ededed",
		"statusBar.noFolderForeground": "#3a3a3a",
		"statusBar.debuggingBackground": "#d6d6d6",
		"statusBar.debuggingForeground": "#1f1f1f",
		"statusBar.focusBorder": "#9a9a9a",
		"statusBarItem.hoverBackground": "#00000010",
		"statusBarItem.hoverForeground": "#1f1f1f",
		"statusBarItem.prominentBackground": "#dcdcdc",
		"statusBarItem.remoteBackground": "#dcdcdc",
		"statusBarItem.remoteForeground": "#1f1f1f",
		"statusBarItem.focusBorder": "#9a9a9a",

		"editorGroup.border": "#00000000",
		"editorGroupHeader.tabsBackground": "#f3f3f3",
		"editorGroupHeader.tabsBorder": "#00000000",
		"tab.activeBackground": "#ffffff",
		"tab.activeForeground": "#1f1f1f",
		"tab.inactiveBackground": "#f3f3f3",
		"tab.inactiveForeground": "#6a6a6a",
		"tab.border": "#00000000",
		"tab.activeBorder": "#ffffff",
		"tab.activeBorderTop": "#2a2a2a",
		"tab.hoverBackground": "#f6f6f6",
		"tab.unfocusedActiveForeground": "#3a3a3a",

		"panel.background": "#ffffff",
		"panel.border": "#00000000",
		// Same field, different host: this only restated `input.border` for inputs inside the
		// panel, so leaving it would keep the rectangle alive in the terminal / output filters.
		"panelInput.border": "#00000000",
		"panelTitle.activeForeground": "#1f1f1f",
		"panelTitle.activeBorder": "#2a2a2a",
		"panelTitle.inactiveForeground": "#6a6a6a",
		"panelSectionHeader.background": "#ffffff",

		"minimap.background": "#ffffff",
		"minimapSlider.background": "#9a9a9a44",

		"breadcrumb.foreground": "#6a6a6a",
		"breadcrumb.focusForeground": "#1f1f1f",
		"breadcrumb.activeSelectionForeground": "#1f1f1f",
		"breadcrumbPicker.background": "#f6f6f6",

		"pickerGroup.foreground": "#6a6a6a",
		"pickerGroup.border": "#e2e2e2",
		"quickInput.background": "#f6f6f6",
		"quickInput.foreground": "#1f1f1f",
		"quickInputList.focusBackground": "#e0e0e0",

		"menu.background": "#ffffff",
		"menu.foreground": "#1f1f1f",
		"menu.selectionBackground": "#dadada",
		"menu.selectionForeground": "#1f1f1f",
		"menu.border": "#e2e2e2",
		"menu.separatorBackground": "#e2e2e2",
		"menubar.selectionBackground": "#e0e0e0",

		"notificationCenterHeader.background": "#f3f3f3",
		"notificationCenterHeader.foreground": "#1f1f1f",
		"notifications.background": "#ffffff",
		"notifications.border": "#e2e2e2",
		"notifications.foreground": "#1f1f1f",

		"keybindingLabel.background": "#ededed",
		"keybindingLabel.foreground": "#2a2a2a",
		"keybindingLabel.border": "#d6d6d6",
		"keybindingLabel.bottomBorder": "#d6d6d6",

		"settings.headerForeground": "#1f1f1f",
		"settings.modifiedItemIndicator": "#8a8a8a",
		"settings.dropdownBackground": "#ffffff",
		"settings.dropdownBorder": "#d0d0d0",

		"welcomePage.tileBackground": "#f3f3f3",
		"welcomePage.tileHoverBackground": "#e8e8e8",
		"welcomePage.progress.foreground": "#6a6a6a",

		"terminal.background": "#ffffff",
		"terminal.foreground": "#2a2a2a",
		"terminalCursor.foreground": "#2a2a2a",
		"terminal.ansiBlack": "#3a3a3a",
		"terminal.ansiBrightBlack": "#6a6a6a",
		"terminal.ansiWhite": "#cfcfcf",
		"terminal.ansiBrightWhite": "#e6e6e6",
		"terminal.ansiRed": "#a85050",
		"terminal.ansiBrightRed": "#b86060",
		"terminal.ansiGreen": "#5f6f53",
		"terminal.ansiBrightGreen": "#6f7f63",
		"terminal.ansiYellow": "#8a7a3a",
		"terminal.ansiBrightYellow": "#9a8a4a",
		"terminal.ansiBlue": "#53606f",
		"terminal.ansiBrightBlue": "#63707f",
		"terminal.ansiMagenta": "#6f5868",
		"terminal.ansiBrightMagenta": "#7f6878",
		"terminal.ansiCyan": "#4e6f6f",
		"terminal.ansiBrightCyan": "#5e7f7f",

		"gitDecoration.modifiedResourceForeground": "#5a5a5a",
		"gitDecoration.deletedResourceForeground": "#a85050",
		"gitDecoration.untrackedResourceForeground": "#5f6f53",
		"gitDecoration.addedResourceForeground": "#5f6f53",

		// Taken from the inline review, which already paints an agent diff INSIDE an editor
		// (openideChat.css `.openide-review-added-line`): the tint is the accent MIXED INTO the
		// editor background, not a translucent overlay. That matters here — the diff editor
		// stacks its line background and its word background, and two translucent layers came
		// out far heavier than the same green anywhere else in the product. Opaque values
		// cannot stack, so a fully added line lands on exactly the review's tone and a changed
		// word inside a modified line gets the next step up.
		"diffEditor.insertedLineBackground": "#d0e8e0",
		"diffEditor.insertedTextBackground": "#aed7c9",
		"diffEditor.removedLineBackground": "#dabcc5",
		"diffEditor.removedTextBackground": "#c89ba9",
		"diffEditorGutter.insertedLineBackground": "#d0e8e0",
		"diffEditorGutter.removedLineBackground": "#dabcc5",
		"diffEditorOverview.insertedForeground": "#2b9771cc",
		"diffEditorOverview.removedForeground": "#c23f60cc",
		"diffEditor.unchangedRegionBackground": "#00000000",

		"gitDecoration.ignoredResourceForeground": "#b0b0b0",
		"gitDecoration.conflictingResourceForeground": "#8a7a3a",

		"editorGutter.modifiedBackground": "#9a9a9a",
		"editorGutter.addedBackground": "#b0b0b0",
		"editorGutter.deletedBackground": "#c08a8a",

		"editorError.foreground": "#a85050",
		"editorWarning.foreground": "#8a7a3a",
		"editorInfo.foreground": "#53606f",

		"editorBracketHighlight.foreground1": "#4a4a4a",
		"editorBracketHighlight.foreground2": "#6a6a6a",
		"editorBracketHighlight.foreground3": "#8a8a8a",
		"editorBracketHighlight.foreground4": "#4a4a4a",
		"editorBracketHighlight.foreground5": "#6a6a6a",
		"editorBracketHighlight.foreground6": "#8a8a8a",
		"editorBracketHighlight.unexpectedBracket.foreground": "#a85050"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a0a1a7", "fontStyle": "italic" } },
		{ "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#a626a4" } },
		{ "scope": ["keyword.operator"], "settings": { "foreground": "#0184bc" } },
		{ "scope": ["string", "string.quoted", "punctuation.definition.string", "string.template"], "settings": { "foreground": "#50a14f" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#986801" } },
		{ "scope": ["variable", "variable.other", "meta.definition.variable.name", "support.variable"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["variable.parameter"], "settings": { "foreground": "#383a42" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#4078f2" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#c18401" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#986801" } },
		{ "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#8a8f98" } },
		{ "scope": ["variable.language", "support.type.property-name"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["markup.heading"], "settings": { "foreground": "#4078f2", "fontStyle": "bold" } },
		{ "scope": ["markup.bold"], "settings": { "foreground": "#986801", "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#50a14f" } }
	],
	"semanticTokenColors": {
		"class": "#c18401",
		"interface": "#c18401",
		"enum": "#c18401",
		"enumMember": "#986801",
		"struct": "#c18401",
		"type": "#c18401",
		"typeParameter": "#c18401",
		"namespace": "#c18401",
		"function": "#4078f2",
		"method": "#4078f2",
		"macro": "#4078f2",
		"property": "#e45649",
		"variable": "#383a42",
		"parameter": "#383a42",
		"keyword": "#a626a4"
	},
	"semanticHighlighting": true
}
